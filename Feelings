
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="Content-Language" content="en">
<meta name="google" content="notranslate">
<title>Feelings Adventure</title>

<style>
*{box-sizing:border-box}
html,body{
 margin:0;min-height:100%;font-family:Arial,Helvetica,sans-serif;
 direction:ltr;text-align:center;
 background:linear-gradient(135deg,#dff7ff,#f7e7ff,#fff3d2);
 color:#30345c
}
body{padding:12px}
button,input{font:inherit}
button{
 border:0;border-radius:14px;padding:13px 18px;margin:5px;
 background:#7658d5;color:white;font-weight:bold;cursor:pointer;
 box-shadow:0 4px 0 #5140a5;touch-action:manipulation
}
button:active{transform:translateY(2px);box-shadow:none}
button:disabled{opacity:.6}
input{
 width:min(100%,350px);padding:14px;border:2px solid #c7b7ff;
 border-radius:13px;text-align:center;font-size:18px;
 direction:ltr
}
h1{color:#7051c6;font-size:clamp(27px,6vw,42px);margin:10px}
h2{font-size:24px}
.teacher{font-weight:bold;color:#df568c;margin:12px}
.panel{
 max-width:760px;width:100%;margin:15px auto;padding:20px;
 background:white;border-radius:24px;
 box-shadow:0 8px 25px #44336618
}
.hidden{display:none!important}
.stats{display:flex;justify-content:space-around;gap:8px;flex-wrap:wrap;font-weight:bold}
.progress{height:10px;background:#eee;border-radius:10px;overflow:hidden;margin:16px 0}
#bar{height:100%;width:0;background:#37c6a0;transition:width .3s}
#picture{font-size:clamp(75px,18vw,115px);margin:10px}
#word{font-size:clamp(27px,6vw,36px);font-weight:bold;color:#7051c6;margin:12px}
#choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:16px 0}
.choice{
 min-width:0;min-height:120px;padding:10px;
 background:#f5f1ff;color:#353254;border:3px solid #e3dbff;
 box-shadow:none;overflow-wrap:anywhere
}
.emoji{display:block;font-size:clamp(36px,10vw,52px)}
.label{display:block;margin-top:7px;font-size:17px}
.correct{background:#dffff2!important;border-color:#30bd8c!important}
.wrong{background:#fff0f3!important;border-color:#f17998!important}
.pink{background:#ff8db4;box-shadow:0 4px 0 #c95c82}
.green{background:#31b994;box-shadow:0 4px 0 #21856d}
#feedback{min-height:30px;font-size:18px;font-weight:bold;margin:12px}
#spellInput{font-size:23px;letter-spacing:1px}
.small{color:#777;font-size:14px}
@media(max-width:380px){
 body{padding:6px}
 .panel{padding:12px;border-radius:18px}
 #choices{gap:6px}
 .choice{min-height:105px;padding:6px}
 .label{font-size:15px}
}
</style>
</head>

<body>
<header>
 <h1>🌈 Feelings Adventure</h1>
 <div class="teacher">Teacher: Ms.Ramezanzadeh</div>
</header>

<main class="panel">
 <section id="start">
  <h2>Ready to Play?</h2>
  <p>Enter your name to start your adventure!</p>
  <form id="startForm">
   <input id="player" maxlength="24" placeholder="Your name"
          aria-label="Your name" autocomplete="given-name" required>
   <br>
   <button type="submit">Let's Play! 🚀</button>
  </form>
  <p class="small">Listen, choose, learn and spell!</p>
 </section>

 <section id="game" class="hidden">
  <h2 id="welcome"></h2>
  <div class="stats">
   <span>⭐ Score: <b id="score">0</b></span>
   <span>❤️ Lives: <b id="lives">5</b></span>
   <span>Question: <b id="number">1</b>/24</span>
  </div>
  <div class="progress"><div id="bar"></div></div>
  <h3 id="stage"></h3>
  <div id="picture"></div>
  <div id="word"></div>
  <button id="listen" class="pink" type="button">🔊 Listen</button>
  <div id="choices"></div>
  <div id="spellArea" class="hidden">
   <p>Listen carefully. Type the correct word!</p>
   <input id="spellInput" placeholder="Type the word"
          aria-label="Type the word" autocomplete="off"
          autocapitalize="none" spellcheck="false">
   <br>
   <button id="checkSpell" type="button">Check Answer ✓</button>
  </div>
  <div id="feedback" aria-live="polite"></div>
  <button id="next" class="green hidden" type="button">Next ➜</button>
 </section>

 <section id="end" class="hidden">
  <h2 id="endTitle">Amazing Job! 🎉</h2>
  <p id="endMessage"></p>
  <h2>⭐ Score: <span id="finalScore"></span>/240</h2>
  <p id="stars"></p>
  <button id="replay" type="button">Play Again 🔄</button>
 </section>
</main>

<script>
"use strict";

// ALL GAME TEXT IS ENGLISH ONLY.
// Do not translate or localize any text into another language.
// Keep every label, message, prompt, and button in English.
const feelings=[
 {word:"Thirsty",emoji:"🥤",sentence:"I am thirsty."},
 {word:"Hungry",emoji:"🍎",sentence:"I am hungry."},
 {word:"Sad",emoji:"😢",sentence:"I am sad."},
 {word:"Shy",emoji:"😊",sentence:"I am shy."},
 {word:"Happy",emoji:"😄",sentence:"I am happy."},
 {word:"Scared",emoji:"😨",sentence:"I am scared."},
 {word:"Sleepy",emoji:"😴",sentence:"I am sleepy."},
 {word:"Tired",emoji:"🥱",sentence:"I am tired."}
];

const $=id=>document.getElementById(id);
let playerName="",score=0,lives=5,index=0,questions=[],current=null,locked=false;

function shuffle(list){
 const a=[...list];
 for(let i=a.length-1;i>0;i--){
  const j=Math.floor(Math.random()*(i+1));
  [a[i],a[j]]=[a[j],a[i]];
 }
 return a;
}

$("startForm").addEventListener("submit",e=>{
 e.preventDefault();
 playerName=$("player").value.trim();
 if(!playerName){$("player").focus();return;}
 score=0;lives=5;index=0;
 questions=[
  ...shuffle(feelings).map(f=>({type:"listen",f})),
  ...shuffle(feelings).map(f=>({type:"picture",f})),
  ...shuffle(feelings).map(f=>({type:"spell",f}))
 ];
 $("start").classList.add("hidden");
 $("end").classList.add("hidden");
 $("game").classList.remove("hidden");
 $("welcome").textContent="Good luck, "+playerName+"!";
 updateStats();
 showQuestion();
});

function speak(text){
 if(!("speechSynthesis" in window)){
  $("feedback").textContent="Audio is not supported in this browser.";
  return;
 }
 speechSynthesis.cancel();
 const utterance=new SpeechSynthesisUtterance(text);
 utterance.lang="en-GB";
 utterance.rate=.82;
 speechSynthesis.speak(utterance);
}

function updateStats(){
 $("score").textContent=score;
 $("lives").textContent="❤️".repeat(lives)+"♡".repeat(5-lives);
 $("number").textContent=Math.min(index+1,24);
 $("bar").style.width=(index/24*100)+"%";
}

function showQuestion(){
 if(lives<=0||index>=questions.length){endGame();return;}
 current=questions[index];
 locked=false;
 $("choices").replaceChildren();
 $("feedback").textContent="";
 $("next").classList.add("hidden");
 $("spellArea").classList.add("hidden");
 $("spellInput").value="";
 $("spellInput").disabled=false;
 $("listen").disabled=false;
 $("picture").textContent="";
 $("word").textContent="";
 $("listen").classList.remove("hidden");

 const f=current.f;
 if(current.type==="listen"){
  $("stage").textContent="Stage 1: Listen and Choose";
  $("word").textContent="🔊 What can you hear?";
  const options=shuffle([f,...shuffle(feelings.filter(x=>x.word!==f.word)).slice(0,3)]);
  options.forEach(option=>{
   const b=document.createElement("button");
   b.type="button";b.className="choice";
   b.innerHTML='<span class="emoji">'+option.emoji+'</span><span class="label">?</span>';
   b.addEventListener("click",()=>choose(option,b));
   $("choices").appendChild(b);
  });
  setTimeout(()=>speak(f.word),350);
 }
 if(current.type==="picture"){
  $("stage").textContent="Stage 2: Find the Feeling";
  $("picture").textContent=f.emoji;
  $("word").textContent=f.word;
  $("listen").classList.add("hidden");
  const options=shuffle([f,...shuffle(feelings.filter(x=>x.word!==f.word)).slice(0,3)]);
  options.forEach(option=>{
   const b=document.createElement("button");
   b.type="button";b.className="choice";
   b.innerHTML='<span class="emoji">'+option.emoji+'</span><span class="label">'+option.word+'</span>';
   b.addEventListener("click",()=>choose(option,b));
   $("choices").appendChild(b);
  });
 }
 if(current.type==="spell"){
  $("stage").textContent="Stage 3: Spelling Challenge";
  $("picture").textContent=f.emoji;
  $("word").textContent="Spell the word!";
  $("spellArea").classList.remove("hidden");
  $("listen").textContent="🔊 Listen Again";
  setTimeout(()=>speak(f.word),350);
  $("spellInput").onkeydown=e=>{
   if(e.key==="Enter"&&!locked)checkSpelling();
  };
 }
 updateStats();
}

$("listen").addEventListener("click",()=>{
 if(current)speak(current.type==="picture"?current.f.sentence:current.f.word);
});

function choose(option,button){
 if(locked)return;
 if(option.word===current.f.word){
  locked=true;score+=10;
  button.classList.add("correct");
  $("feedback").textContent="🌟 Excellent! That's correct!";
  speak("Excellent! "+current.f.word);
  finishQuestion();
 }else{
  button.classList.add("wrong");
  button.disabled=true;
  lives--;
  $("feedback").textContent="😊 Try again!";
  updateStats();
  speak("Try again!");
  if(lives<=0){
   locked=true;
   finishQuestion();
  }
 }
}

function checkSpelling(){
 if(locked)return;
 const answer=$("spellInput").value.trim().toLowerCase();
 if(answer===current.f.word.toLowerCase()){
  locked=true;score+=10;
  $("feedback").textContent="🎉 Perfect spelling! Well done!";
  speak("Well done! "+current.f.word);
  finishQuestion();
 }else{
  lives--;
  updateStats();
  if(lives<=0){
   locked=true;
   $("feedback").textContent="Good try! The word was "+current.f.word+".";
   finishQuestion();
  }else{
   $("feedback").textContent="Not quite! Listen and try again.";
   $("spellInput").select();
   speak("Try again!");
  }
 }
}

function finishQuestion(){
 $("choices").querySelectorAll("button").forEach(b=>b.disabled=true);
 $("spellInput").disabled=true;
 $("listen").disabled=true;
 $("next").classList.remove("hidden");
 updateStats();
}

$("next").addEventListener("click",()=>{
 index++;
 showQuestion();
});

function endGame(){
 $("game").classList.add("hidden");
 $("end").classList.remove("hidden");
 $("bar").style.width="100%";
 $("finalScore").textContent=score;
 $("endTitle").textContent=lives>0?"Amazing Job, "+playerName+"! 🎉":"Good Try, "+playerName+"! 💛";
 $("endMessage").textContent="You completed the Feelings Adventure!";
 $("stars").textContent=score>=192?"⭐⭐⭐ Fantastic work!":
  score>=120?"⭐⭐ Great effort!":"⭐ Keep practicing!";
 speak(lives>0?"Amazing job, "+playerName+"!":"Good try, "+playerName+"!");
}

$("replay").addEventListener("click",()=>{
 speechSynthesis?.cancel?.();
 $("end").classList.add("hidden");
 $("start").classList.remove("hidden");
 $("player").value="";
 $("player").focus();
});
</script>
</body>
</html>
